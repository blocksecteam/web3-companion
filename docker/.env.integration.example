# Integration test environment.
# Copy to docker/.env.integration and fill in values.
# This file is gitignored — your keys stay local.
#
# The pre-push hook automatically loads docker/.env.integration
# and runs integration tests if WEB3_INTEGRATION=1.

WEB3_INTEGRATION=1

# Chain RPC URLs — integration tests call real RPC endpoints.
# Use your own Alchemy/Infura/QuickNode keys for reliable results.
WEB3_RPC_ETHEREUM_URL=
WEB3_RPC_BASE_URL=
WEB3_RPC_POLYGON_URL=
WEB3_RPC_BSC_URL=

# External data providers (optional — tests skip if not set)
PORTALS_API_KEY=
METASLEUTH_API_KEY=
