# Optional Web3 Companion environment overrides.
# Normal Docker startup does not require a .env file. Use this file only as a
# reference if you want to export variables in your shell or create a local
# compose override for advanced deployments.

# Docker port (default 8081)
WEB3_PORT=8081

# Browser URL — only needed for domain-based access (Passkey binds to this).
# For local use, leave commented — defaults to http://localhost:$WEB3_PORT.
# WEB3_EXTERNAL_URL=https://web3.example.com

# Chain RPC URLs — these public endpoints work out of the box but do NOT
# support debug_traceCall, which limits the transaction security review.
# Replace with your own Alchemy/Infura/QuickNode endpoint for full
# trace-based security analysis.
WEB3_RPC_ETHEREUM_URL=https://eth.rpc.blocksec.com
WEB3_RPC_BASE_URL=https://developer-access-mainnet.base.org
WEB3_RPC_POLYGON_URL=https://rpc-mainnet.matic.quiknode.pro
WEB3_RPC_BSC_URL=https://bsc.rpc.blocksec.com

# Optional AWS KMS (replaces auto-generated SSM key).
# Set all four or leave all commented.
# AWS_REGION=us-east-1
# AWS_KMS_KEY_ID=arn:aws:kms:us-east-1:123456789012:key/your-key-id
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# LLM provider — configurable in the web UI (Setup Wizard / Settings).
# Set these only if you need startup-time defaults.
WEB3_LLM_PROVIDER=deepseek
WEB3_LLM_BASE_URL=https://api.deepseek.com/anthropic
WEB3_LLM_MODEL=deepseek-v4-pro
WEB3_LLM_API_KEY=
